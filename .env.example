# PostgreSQL
ConnectionStrings__DefaultConnection=Host=aws-0-us-west-2.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;Pooling=false;SSL Mode=Require;Trust Server Certificate=true

